---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Template proyek — isi sendiri sesuai kebutuhan
const projects = [
  {
    id: 1,
    title: 'MySporty Application',
    description:
      'Aplikasi olahraga yang secara otomatis melacak gerakan latihan menggunakan kamera perangkat. Dibangun dengan Android Jetpack Compose (Kotlin), terintegrasi dengan Supabase untuk penyimpanan data, dan TensorFlow Lite untuk model machine learning.',
    category: 'Android',
    tags: ['Kotlin', 'Jetpack Compose', 'TFLite', 'Supabase'],
    image: '/project-1.png',
    highlight: true,
    award: '🥇 Gold Medal IIIEX',
  },
  {
    id: 2,
    title: 'BelaBeli Marketplace API',
    description:
      'Backend marketplace menggunakan Laravel. Fitur meliputi sistem rekomendasi produk, keranjang belanja, katalog produk, manajemen produk, ulasan & rating, serta integrasi pembayaran QRIS.',
    category: 'Backend',
    tags: ['Laravel', 'PHP', 'MySQL', 'QRIS'],
    image: '/project-2.png',
    highlight: false,
  },
  {
    id: 3,
    title: 'NSMHC — Nursing Student Motherheart Connection',
    description:
      'Platform pelatihan untuk membantu ibu berlatih teknik mindfulness dan manajemen emosional. Saya berperan sebagai Backend Developer menggunakan Laravel, membangun API untuk aplikasi mobile dan web dashboard.',
    category: 'Backend',
    tags: ['Laravel', 'PHP', 'API', 'Mobile'],
    image: '/project-3.png',
    highlight: false,
  },
  {
    id: 4,
    title: 'House Shiatsu & Spa App',
    description:
      'Aplikasi mobile untuk pemesanan terapis pijat di Griya Bugar. Memungkinkan pengguna memesan terapis dan terintegrasi dengan Firebase Cloud Messaging untuk notifikasi real-time ke admin.',
    category: 'Android',
    tags: ['Android', 'Kotlin', 'Firebase', 'FCM'],
    image: '/project-1.png',
    highlight: false,
  },
  {
    id: 5,
    title: 'Sistem Manajemen Unit Kegiatan Mahasiswa',
    description:
      'Sistem informasi untuk Unit Kegiatan Mahasiswa menggunakan Laravel (backend) dan Next.js (frontend). Fitur: role user (Admin, User, Super Admin), penjadwalan tugas, jadwal rapat, daftar anggota, formulir pendaftaran, dan verifikasi email.',
    category: 'Full-Stack',
    tags: ['Laravel', 'Next.js', 'MySQL', 'Auth'],
    image: '/project-2.png',
    highlight: false,
  },
  {
    id: 6,
    title: 'Nutrient — Nutrition Table Assistant',
    description:
      'Aplikasi Android untuk memindai label nutrisi makanan dan mengubahnya menjadi informasi berguna berdasarkan BMI pengguna. Bertemakan Health Innovation untuk komunitas rentan.',
    category: 'Android',
    tags: ['Android', 'Kotlin', 'ML', 'Health'],
    image: '/project-3.png',
    highlight: false,
  },
  {
    id: 7,
    title: 'Fitrack Mobile Apps',
    description:
      'Aplikasi mobile untuk memantau kesehatan fisik. Membantu pengguna menjaga kebugaran dengan pelacakan komprehensif aktivitas harian dan asupan makanan. Saya berperan sebagai Backend Developer.',
    category: 'Backend',
    tags: ['API', 'Laravel', 'Mobile', 'Health'],
    image: '/project-1.png',
    highlight: false,
  },
  {
    id: 8,
    title: 'Serenade Story — Wedding Organizer Website',
    description:
      'Website Wedding Organizer yang dibangun dengan Next.js. Tugas meliputi implementasi desain responsif dari Figma, pagination artikel, dan penyempurnaan fitur chat.',
    category: 'Frontend',
    tags: ['Next.js', 'React', 'Figma', 'TailwindCSS'],
    image: '/project-2.png',
    highlight: false,
  },
  {
    id: 9,
    title: 'E-commerce Buah & Produk Segar',
    description:
      'Website e-commerce berbasis Laravel untuk penjualan buah dan produk lainnya. Fitur: WhatsApp Gateway untuk konfirmasi pesanan, invoice, keranjang belanja, dan keamanan akun (email verification & password recovery).',
    category: 'Full-Stack',
    tags: ['Laravel', 'PHP', 'WhatsApp API', 'MySQL'],
    image: '/project-3.png',
    highlight: false,
  },
];

const categoryColors: Record<string, string> = {
  Android: 'bg-green-100 text-green-700',
  Backend: 'bg-blue-100 text-blue-700',
  Frontend: 'bg-orange-100 text-orange-700',
  'Full-Stack': 'bg-purple-100 text-purple-700',
};

const categories = ['Semua', 'Android', 'Backend', 'Frontend', 'Full-Stack'];
---

<Layout
  title="Portofolio — Muhammad Mizzy | Full-Stack Developer"
  description="Semua proyek dan karya Muhammad Mizzy — Full-Stack Developer, Android Developer, dan Backend Developer."
>
  <Navbar />

  <main class="pt-24 pb-0 bg-[var(--color-white)] min-h-screen">
    <!-- Page Header -->
    <section class="section-py border-b border-gray-100">
      <div class="container-custom">
        <div class="max-w-2xl">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-xs text-[var(--color-secondary)] font-medium hover:text-[var(--color-primary)] transition-colors duration-200 mb-6"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M5 12l7 7M5 12l7-7"></path>
            </svg>
            Kembali ke Beranda
          </a>
          <span
            class="inline-block text-xs font-semibold tracking-widest text-[var(--color-secondary)] uppercase mb-4"
            >Portofolio</span
          >
          <h1
            class="text-4xl md:text-6xl font-bold text-[var(--color-primary)] leading-tight mb-6"
          >
            Semua Proyek Saya
          </h1>
          <p class="text-[var(--color-secondary)] text-base leading-relaxed">
            Kumpulan proyek yang telah saya kerjakan — dari aplikasi Android bertenaga
            machine learning, REST API, hingga website full-stack. Template ini bisa
            kamu isi dengan proyek-proyekmu sendiri.
          </p>
        </div>
      </div>
    </section>

    <!-- Filter & Grid -->
    <section class="section-py">
      <div class="container-custom">
        <!-- Category filter -->
        <div id="filter-bar" class="flex flex-wrap gap-3 mb-12">
          {
            categories.map((cat) => (
              <button
                data-category={cat}
                class={`filter-btn text-xs font-semibold px-4 py-2 rounded-full border transition-all duration-200 ${
                  cat === 'Semua'
                    ? 'bg-[var(--color-primary)] text-white border-[var(--color-primary)]'
                    : 'border-gray-200 text-[var(--color-secondary)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]'
                }`}
              >
                {cat}
              </button>
            ))
          }
        </div>

        <!-- Projects grid -->
        <div
          id="projects-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        >
          {
            projects.map((project) => (
              <article
                class="group cursor-pointer project-card"
                data-category={project.category}
              >
                <!-- Image -->
                <div class="relative overflow-hidden rounded-2xl aspect-[4/3] mb-5 bg-gray-100">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  {project.highlight && (
                    <div class="absolute top-3 left-3">
                      <span class="text-xs font-bold px-3 py-1.5 rounded-full bg-yellow-400 text-yellow-900">
                        {project.award}
                      </span>
                    </div>
                  )}
                  <!-- Overlay -->
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300 flex items-center justify-center">
                    <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-300">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M7 17L17 7M17 7H7M17 7v10" />
                      </svg>
                    </div>
                  </div>
                </div>

                <!-- Meta -->
                <div class="flex items-center gap-3 mb-3">
                  <span class={`text-xs font-semibold px-3 py-1 rounded-full ${categoryColors[project.category] || 'bg-gray-100 text-gray-700'}`}>
                    {project.category}
                  </span>
                </div>

                <!-- Title & Description -->
                <h2 class="text-base font-bold text-[var(--color-primary)] leading-snug mb-2 group-hover:text-[var(--color-secondary)] transition-colors duration-200">
                  {project.title}
                </h2>
                <p class="text-sm text-[var(--color-secondary)] leading-relaxed line-clamp-3 mb-4">
                  {project.description}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-[var(--color-tertiary)] text-[var(--color-secondary)] border border-gray-200">
                      {tag}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category || 'Semua';

      // Update active button
      filterBtns.forEach((b) => {
        b.classList.remove('bg-[var(--color-primary)]', 'text-white', 'border-[var(--color-primary)]');
        b.classList.add('border-gray-200', 'text-[var(--color-secondary)]');
      });
      btn.classList.add('bg-[var(--color-primary)]', 'text-white', 'border-[var(--color-primary)]');
      btn.classList.remove('border-gray-200', 'text-[var(--color-secondary)]');

      // Filter cards
      projectCards.forEach((card) => {
        if (category === 'Semua' || card.dataset.category === category) {
          card.style.display = '';
          card.style.animation = 'fadeIn 0.3s ease forwards';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
