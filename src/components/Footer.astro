---
// Footer
---

<footer class="bg-[var(--color-primary)] py-12">
  <div class="container-custom">
    <!-- Nav links row -->
    <div class="flex flex-wrap items-center justify-center gap-8 mb-10 pb-10 border-b border-white/10">
      <a
        href="#hero"
        class="text-sm text-white/60 hover:text-white transition-colors duration-200 font-medium"
        >Home</a>
      <a
        href="#about"
        class="text-sm text-white/60 hover:text-white transition-colors duration-200 font-medium"
        >About Me</a>
      <a
        href="#works"
        class="text-sm text-white/60 hover:text-white transition-colors duration-200 font-medium"
        >Portfolio</a>
      <a
        href="#experience"
        class="text-sm text-white/60 hover:text-white transition-colors duration-200 font-medium"
        >Experience</a>
      <a
        href="#skills"
        class="text-sm text-white/60 hover:text-white transition-colors duration-200 font-medium"
        >Skills</a>
    </div>

    <!-- Large email -->
    <div class="text-center mb-10">
      <a
        href="mailto:mizzy12342@email.com"
        class="text-[clamp(2rem,6vw,5rem)] font-bold text-white hover:text-white/80 transition-colors duration-300 leading-none tracking-tight"
      >
        mizzy12342@gmail.com
      </a>
    </div>

    <!-- Bottom row -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-white/10"
    >
      <p class="text-xs text-white/40 font-medium">
        © {new Date().getFullYear()} Muhammad Mizzy. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="#"
          class="text-xs text-white/40 hover:text-white/80 transition-colors duration-200"
          >Privacy Policy</a>
        <span class="text-white/20">·</span>
        <a
          href="#"
          class="text-xs text-white/40 hover:text-white/80 transition-colors duration-200"
          >Terms of Service</a>
      </div>
      <!-- Social icons -->
      <div class="flex items-center gap-3">
        <a
          href="#"
          aria-label="LinkedIn"
          class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:border-white/60 hover:text-white transition-all duration-200"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"
            ></path>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a
          href="#"
          aria-label="GitHub"
          class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:border-white/60 hover:text-white transition-all duration-200"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a
          href="#"
          aria-label="Instagram"
          class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:border-white/60 hover:text-white transition-all duration-200"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
