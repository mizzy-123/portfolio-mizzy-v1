---
// About Me Section - Developer version (Bahasa Indonesia)
---

<section
  id="about"
  class="section-py bg-[var(--color-white)] border-t border-gray-100"
>
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Col 1: Bio Text -->
      <div class="lg:col-span-4">
        <span
          class="inline-block text-xs font-semibold tracking-widest text-[var(--color-secondary)] uppercase mb-4"
          >Tentang Saya</span
        >
        <h2
          class="text-3xl md:text-4xl font-bold text-[var(--color-primary)] leading-tight mb-6"
        >
          Membangun solusi digital yang efisien dan scalable
        </h2>
        <p class="text-[var(--color-secondary)] text-base leading-relaxed mb-8">
          Saya adalah seorang Full-Stack Developer dengan pengalaman membangun
          aplikasi web dan mobile menggunakan berbagai teknologi modern. Saya
          senang menyelesaikan masalah teknis yang kompleks dan mengubahnya
          menjadi produk digital yang fungsional dan mudah digunakan.
        </p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] hover:gap-4 transition-all duration-200"
        >
          Mari berkolaborasi
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </div>

      <!-- Col 2: Big Metric -->
      <div class="lg:col-span-3 flex flex-col justify-start">
        <div
          class="bg-[var(--color-tertiary)] rounded-2xl p-8 text-center aspect-square flex flex-col items-center justify-center"
        >
          <div
            class="w-12 h-12 rounded-full bg-[var(--color-primary)] text-white flex items-center justify-center mb-6"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <p
            class="text-6xl md:text-7xl font-bold text-[var(--color-primary)] leading-none"
          >
            3.84
          </p>
          <p class="text-sm text-[var(--color-secondary)] mt-3 text-center leading-snug">
            IPK Kumulatif dari Politeknik Negeri Semarang
          </p>
        </div>
      </div>

      <!-- Col 3: Portrait + Description -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Portrait thumbnails -->
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl overflow-hidden aspect-square bg-[var(--color-tertiary)]">
            <img
              src="/hero-portrait.png"
              alt="Muhammad Mizzy bekerja"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
            />
          </div>
          <div
            class="rounded-2xl overflow-hidden aspect-square bg-[var(--color-tertiary)] relative"
          >
            <img
              src="/hero-portrait.png"
              alt="Muhammad Mizzy"
              class="w-full h-full object-cover object-top grayscale hover:grayscale-0 transition-all duration-500 absolute inset-0 rounded-2xl"
            />
          </div>
        </div>

        <!-- Skill cards -->
        <div class="space-y-3">
          <div
            class="flex items-start gap-4 p-4 rounded-2xl bg-[var(--color-tertiary)] hover:bg-gray-100 transition-colors duration-200"
          >
            <div
              class="w-8 h-8 rounded-full bg-[var(--color-primary)] flex items-center justify-center flex-shrink-0 mt-0.5"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2.5"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-primary)]">
                Full-Stack & Mobile Developer
              </p>
              <p class="text-xs text-[var(--color-secondary)] mt-0.5 leading-relaxed">
                Berpengalaman membangun aplikasi web menggunakan Laravel, Next.js,
                dan aplikasi Android Native (Kotlin) dengan Jetpack Compose.
              </p>
            </div>
          </div>

          <div
            class="flex items-start gap-4 p-4 rounded-2xl bg-[var(--color-tertiary)] hover:bg-gray-100 transition-colors duration-200"
          >
            <div
              class="w-8 h-8 rounded-full bg-[var(--color-primary)] flex items-center justify-center flex-shrink-0 mt-0.5"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2.5"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-primary)]">
                Peraih Gold Medal IIIEX
              </p>
              <p class="text-xs text-[var(--color-secondary)] mt-0.5 leading-relaxed">
                Meraih Gold Medal & MIICA Special Award pada Indonesia
                International Invention Expo untuk proyek MySporty Application.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
