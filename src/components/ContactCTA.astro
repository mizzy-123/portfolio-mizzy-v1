---
// Contact CTA Section
---

<section
  id="contact"
  class="section-py bg-[var(--color-tertiary)] border-t border-gray-100"
>
  <div class="container-custom text-center max-w-3xl mx-auto">
    <h2
      class="text-4xl md:text-6xl font-bold text-[var(--color-primary)] leading-tight mb-6"
    >
      Got a Vision? Let's Bring It to Life!
    </h2>
    <p class="text-[var(--color-secondary)] text-base md:text-lg leading-relaxed mb-10 max-w-2xl mx-auto">
      I'm always excited to collaborate on new and interesting projects.
      Whether starting from scratch or continuing an existing one,
      let's build something great together.
    </p>
    <a
      href="https://api.whatsapp.com/send/?phone=6282141765353&text&type=phone_number&app_absent=0"
      class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[var(--color-primary)] text-white text-sm font-semibold hover:bg-[#444] transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
    >
      Send a Message
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M7 17L17 7M17 7H7M17 7v10"></path>
      </svg>
    </a>
  </div>
</section>
