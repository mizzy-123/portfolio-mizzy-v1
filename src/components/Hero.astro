---
// Hero Section
---

<section
  id="hero"
  class="relative min-h-screen bg-[var(--color-white)] overflow-hidden flex flex-col"
>
  <!-- Top divider line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gray-200 mt-[72px]"></div>

  <div class="container-custom flex-1 flex flex-col justify-center pt-24 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center min-h-[80vh]">
      <!-- Left: Text Content -->
      <div class="relative flex flex-col justify-center order-2 lg:order-1">
        <!-- Stats row -->
        <div class="flex gap-8 mb-8">
          <div>
            <p
              class="text-4xl font-bold text-[var(--color-primary)] leading-none"
            >
              *200
            </p>
            <p class="text-xs text-[var(--color-secondary)] mt-1 font-medium">
              Project completed
            </p>
          </div>
          <div>
            <p
              class="text-4xl font-bold text-[var(--color-primary)] leading-none"
            >
              *50
            </p>
            <p class="text-xs text-[var(--color-secondary)] mt-1 font-medium">
              Start-up raised
            </p>
          </div>
        </div>

        <!-- Large Hello -->
        <div class="relative">
          <h1
            id="hero-hello"
            class="text-[clamp(6rem,15vw,14rem)] font-bold leading-none tracking-tighter text-[var(--color-primary)] select-none"
            style="font-variation-settings: 'wght' 800;"
          >
            Hello
          </h1>

          <!-- Tagline below Hello -->
          <div class="mt-4 flex items-center gap-2">
            <span class="text-[var(--color-secondary)] text-sm">—</span>
            <p class="text-sm text-[var(--color-secondary)] font-medium">
              Hi! It's <span class="text-[var(--color-primary)] font-semibold"
                >Your Name</span
              >, a design visionary
            </p>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="mt-12 flex items-center gap-3">
          <button
            class="group flex items-center gap-2 text-xs text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors duration-200 font-medium cursor-pointer bg-transparent border-none p-0"
            onclick="document.getElementById('about')?.scrollIntoView({behavior:'smooth'})"
          >
            <span
              class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-[var(--color-secondary)] group-hover:border-[var(--color-primary)] group-hover:bg-[var(--color-primary)] group-hover:text-white transition-all duration-300"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12l7 7 7-7"></path>
              </svg>
            </span>
            Scroll down
          </button>
        </div>
      </div>

      <!-- Right: Portrait Image -->
      <div
        class="relative order-1 lg:order-2 flex items-center justify-center lg:justify-end"
      >
        <div
          class="relative w-[300px] h-[380px] md:w-[400px] md:h-[500px] lg:w-[460px] lg:h-[560px]"
        >
          <!-- Background shape -->
          <div
            class="absolute inset-0 rounded-3xl bg-[var(--color-tertiary)] translate-x-3 translate-y-3"
          >
          </div>
          <!-- Portrait -->
          <img
            src="/hero-portrait.png"
            alt="Designer portrait"
            class="relative z-10 w-full h-full object-cover rounded-3xl grayscale"
          />
          <!-- Floating badge -->
          <div
            class="absolute bottom-8 -left-6 z-20 bg-white rounded-2xl px-4 py-3 shadow-xl border border-gray-100"
          >
            <p class="text-xs text-[var(--color-secondary)] font-medium">
              Available for work
            </p>
            <div class="flex items-center gap-1.5 mt-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
              ></span>
              <p class="text-sm font-bold text-[var(--color-primary)]">
                Open to Projects
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom decorative line -->
  <div
    class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gray-200 to-transparent"
  >
  </div>
</section>

<script>
  // Animate stats on load
  const animateNumber = (el: HTMLElement, target: number, prefix = '') => {
    let current = 0;
    const step = target / 60;
    const timer = setInterval(() => {
      current = Math.min(current + step, target);
      el.textContent = prefix + Math.floor(current);
      if (current >= target) clearInterval(timer);
    }, 16);
  };

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const stats = document.querySelectorAll<HTMLElement>('.stat-number');
      stats.forEach((el) => {
        const target = parseInt(el.dataset.target || '0');
        animateNumber(el, target, '*');
      });
    }, 300);
  });
</script>
