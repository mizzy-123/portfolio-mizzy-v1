---
// Navbar component
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div
    class="container-custom flex items-center justify-between py-5"
  >
    <!-- Logo -->
    <a
      href="#hero"
      class="flex items-center gap-2 text-[var(--color-primary)] no-underline"
    >
      <div
        class="w-8 h-8 rounded-full bg-[var(--color-primary)] flex items-center justify-center"
      >
        <span class="text-white text-xs font-bold">MM</span>
      </div>
      <span class="font-semibold text-sm tracking-wide">Muhammad Mizzy</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="#about"
        class="text-sm text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors duration-200 font-medium"
      >About Me</a
      >
      <a
        href="#works"
        class="text-sm text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors duration-200 font-medium"
        >Portfolio</a
      >
      <a
        href="#experience"
        class="text-sm text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors duration-200 font-medium"
        >Services</a
      >
      <a
        href="#blog"
        class="text-sm text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors duration-200 font-medium"
        >Blog</a
      >
    </nav>

    <!-- CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[var(--color-primary)] text-sm font-medium text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all duration-200"
      >
        Book a Call
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M7 17L17 7M17 7H7M17 7v10"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer"
      aria-label="Toggle menu"
    >
      <span
        class="block w-6 h-0.5 bg-[var(--color-primary)] transition-all duration-300"
        id="menu-line-1"></span>
      <span
        class="block w-6 h-0.5 bg-[var(--color-primary)] transition-all duration-300"
        id="menu-line-2"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-white border-t border-gray-100 px-6 py-6"
  >
    <nav class="flex flex-col gap-4">
      <a href="#about" class="text-sm font-medium text-[var(--color-primary)]"
        >About Me</a
      >
      <a href="#works" class="text-sm font-medium text-[var(--color-primary)]"
        >Portfolio</a
      >
      <a
        href="#experience"
        class="text-sm font-medium text-[var(--color-primary)]">Services</a
      >
      <a href="#blog" class="text-sm font-medium text-[var(--color-primary)]"
        >Blog</a
      >
      <a
        href="#contact"
        class="mt-2 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-primary)] text-sm font-medium text-white w-fit"
        >Book a Call</a
      >
    </nav>
  </div>
</header>

<script>
  // Navbar scroll behavior
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
    } else {
      navbar?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
    }
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('menu-line-1');
  const line2 = document.getElementById('menu-line-2');
  let isOpen = false;

  menuBtn?.addEventListener('click', () => {
    isOpen = !isOpen;
    mobileMenu?.classList.toggle('hidden', !isOpen);
    if (isOpen) {
      line1?.classList.add('rotate-45', 'translate-y-2');
      line2?.classList.add('-rotate-45', '-translate-y-0');
    } else {
      line1?.classList.remove('rotate-45', 'translate-y-2');
      line2?.classList.remove('-rotate-45', '-translate-y-0');
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu?.classList.add('hidden');
      line1?.classList.remove('rotate-45', 'translate-y-2');
      line2?.classList.remove('-rotate-45', '-translate-y-0');
    });
  });
</script>
