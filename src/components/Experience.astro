---
// Experience Section - Pengalaman Kerja Mizzy dari CV (Bahasa Indonesia)
const experiences = [
  {
    id: 1,
    company: 'Campus Digital Indonesia',
    role: 'Backend Developer (Magang)',
    date: 'Februari 2024 – Mei 2024',
    description:
      'Bekerja sebagai Backend Developer menggunakan Laravel, bertanggung jawab membangun API marketplace BelaBeli. Tugas meliputi sistem rekomendasi produk, keranjang belanja, katalog produk, manajemen produk, ulasan & rating, serta implementasi integrasi pembayaran manual menggunakan QRIS.',
    tags: ['Laravel', 'PHP', 'API'],
    featured: true,
  },
  {
    id: 2,
    company: 'Serenade Story',
    role: 'Frontend Developer (Magang)',
    date: 'Agustus 2023 – November 2023',
    description:
      'Bekerja sebagai Frontend Developer, mengembangkan aplikasi Next.js. Tugas meliputi memastikan desain responsif, mengimplementasikan desain dari Figma, menerapkan pagination untuk artikel, dan menyempurnakan fitur chat.',
    tags: ['Next.js', 'React', 'Figma'],
    featured: false,
  },
  {
    id: 3,
    company: 'Bangkit Academy (Google, GoTo, Traveloka)',
    role: 'Android Developer Cohort',
    date: 'Februari 2024 – Juli 2024',
    description:
      'Mempelajari materi terkait pengembangan aplikasi Android menggunakan Kotlin dan Android Studio. Mengimplementasikan model machine learning menggunakan TFLite, menggunakan library ML Kit, dan berkolaborasi dengan tim untuk mengembangkan aplikasi Android berdasarkan studi kasus yang diberikan.',
    tags: ['Kotlin', 'Android', 'ML Kit'],
    featured: false,
  },
  {
    id: 4,
    company: 'Politeknik Negeri Semarang',
    role: 'Mahasiswa — D4 Teknik Informatika Terapan',
    date: 'September 2021 – September 2025',
    description:
      'Menempuh pendidikan D4 Teknik Informatika Terapan dengan IPK Kumulatif 3.84/4.0. Mata kuliah relevan: Pemrograman Berorientasi Objek, Struktur Data, Desain Database, Pemrograman Mobile, dan Pengembangan Web Berbasis Framework.',
    tags: ['Akademik', 'IPK 3.84'],
    featured: false,
  },
];
---

<section
  id="experience"
  class="section-py bg-[var(--color-white)] border-t border-gray-100"
>
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left: Title -->
      <div class="lg:col-span-4">
        <span
          class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-[var(--color-secondary)] uppercase mb-4"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
          Pengalaman
        </span>
        <h2
          class="text-3xl md:text-4xl font-bold text-[var(--color-primary)] leading-tight mb-6"
        >
          Perjalanan Karir & Pendidikan Saya
        </h2>
        <p class="text-[var(--color-secondary)] text-sm leading-relaxed mb-8">
          Selama perjalanan sebagai developer, saya telah berkesempatan bekerja
          pada berbagai proyek nyata — dari membangun API marketplace, aplikasi
          Android bertenaga ML, hingga frontend berbasis Next.js.
        </p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-primary)] text-white text-sm font-medium hover:bg-[#444] transition-all duration-200"
        >
          Hubungi Saya
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </div>

      <!-- Right: Experience List -->
      <div class="lg:col-span-8">
        <div class="divide-y divide-gray-100">
          {
            experiences.map((exp) => (
              <div class="group py-6 flex flex-col md:flex-row md:items-start gap-4 hover:bg-[var(--color-tertiary)] -mx-4 px-4 rounded-2xl transition-colors duration-200 cursor-pointer">
                <!-- Date -->
                <div class="md:w-48 flex-shrink-0">
                  <p class="text-xs text-[var(--color-secondary)] font-medium">
                    {exp.date}
                  </p>
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <h3 class="text-base font-semibold text-[var(--color-primary)] mb-0.5">
                    {exp.company}
                  </h3>
                  <p class="text-xs text-[var(--color-secondary)] font-medium mb-2 italic">
                    {exp.role}
                  </p>
                  {exp.featured && (
                    <div class="flex gap-3 mb-3">
                      <img
                        src="/project-1.png"
                        alt={exp.company}
                        class="w-16 h-12 object-cover rounded-lg flex-shrink-0"
                      />
                      <img
                        src="/project-2.png"
                        alt={exp.company}
                        class="w-16 h-12 object-cover rounded-lg flex-shrink-0"
                      />
                    </div>
                  )}
                  <p class="text-sm text-[var(--color-secondary)] leading-relaxed">
                    {exp.description}
                  </p>
                </div>

                <!-- Tags + arrow -->
                <div class="flex items-center gap-2 md:flex-col md:items-end flex-shrink-0">
                  <div class="flex flex-wrap gap-1.5 justify-end">
                    {exp.tags.map((tag) => (
                      <span class="text-xs font-medium px-3 py-1 rounded-full border border-[var(--color-secondary)] text-[var(--color-secondary)] group-hover:border-[var(--color-primary)] group-hover:text-[var(--color-primary)] transition-colors duration-200">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <div class="w-8 h-8 rounded-full border border-gray-200 group-hover:bg-[var(--color-primary)] group-hover:border-[var(--color-primary)] group-hover:text-white text-[var(--color-secondary)] flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 mt-1">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M7 17L17 7M17 7H7M17 7v10" />
                    </svg>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
