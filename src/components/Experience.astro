---
// Experience Section - Mizzy's real work history from CV
const experiences = [
  {
    id: 1,
    company: 'PT Logika Data, Semarang (Remote/WFH)',
    role: 'Software Developer',
    date: 'Desember 2025 – Present',
    description:
      'Spearhead the end-to-end development lifecycle across web and mobile platforms, actively translating dynamic business requirements into scalable functional features. Architect and deploy highly responsive frontend interfaces utilizing Next.js, supported by robust server-side architecture and RESTful APIs built with Express.js. Concurrently manage native Android development (Gradle), refactoring existing codebases and customizing UI/UX components with Jetpack Compose to ensure an intuitive, responsive mobile experience. Consistently maintain system stability and cross-platform performance by integrating new custom functionalities and systematically resolving complex bugs across the entire application ecosystem.',
    tags: ['Next Js', 'Express Js', 'Android'],
    featured: false,
  },
  {
    id: 2,
    company: 'PT Violet Global Indonesia, Semarang (Hybrid)',
    role: 'FullStack Developer',
    date: 'October 2025 – February 2026',
    description:
      'Engineered scalable RESTful APIs utilizing Django (Python) to support high-performance frontend interactions and ensure seamless data flow. Optimized system architecture by implementing asynchronous background processing with Celery to manage intensive file uploads, significantly reducing server response times and elevating the overall user experience. Additionally, developed a robust document management system featuring secure storage handling and automated deletion workflows to maximize database capacity and overall storage efficiency.',
    tags: ['Django', 'Python'],
    featured: false,
  },
  {
    id: 3,
    company: "Campus Digital Indonesia",
    role: "Backend Developer (Internship)",
    date: "February 2024 – May 2024",
    description:
      "Worked as a Backend Developer using Laravel, responsible for building the BelaBeli marketplace API. Tasks included developing the product recommendation system, shopping cart, product catalog, product management, ratings and reviews, as well as implementing manual payment integration using QRIS.",
    tags: ["Laravel", "PHP", "API"],
    featured: false,
  },
  {
    id: 4,
    company: "Serenade Story",
    role: "Frontend Developer (Internship)",
    date: "August 2023 – November 2023",
    description:
      "Worked as a Frontend Developer, developing a Next.js application. Tasks included ensuring responsive design, implementing designs from Figma, implementing pagination for articles, and refining the chat feature.",
    tags: ["Next.js", "React", "Figma"],
    featured: false,
  },
  {
    id: 5,
    company: "Bangkit Academy (Google, GoTo, Traveloka)",
    role: "Android Developer Cohort",
    date: "February 2024 – July 2024",
    description:
      "Studied Android application development using Kotlin and Android Studio. Implemented a machine learning model using TFLite, learned to use ML Kit, and collaborated with a team to develop Android applications based on given case studies.",
    tags: ["Kotlin", "Android", "ML Kit"],
    featured: false,
  },
];
---

<section
  id="experience"
  class="section-py bg-[var(--color-white)] border-t border-gray-100"
>
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left: Title -->
      <div class="lg:col-span-4">
        <span
          class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-[var(--color-secondary)] uppercase mb-4"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
          Experience
        </span>
        <h2
          class="text-3xl md:text-4xl font-bold text-[var(--color-primary)] leading-tight mb-6"
        >
          My Career & My Journey
        </h2>
        <p class="text-[var(--color-secondary)] text-sm leading-relaxed mb-8">
          Throughout my journey as a developer, I've had the opportunity to work
          on real-world projects — from building marketplace APIs and
          ML-powered Android apps to Next.js frontends.
        </p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-primary)] text-white text-sm font-medium hover:bg-[#444] transition-all duration-200"
        >
          Contact Me
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </div>

      <!-- Right: Experience List -->
      <div class="lg:col-span-8">
        <div class="divide-y divide-gray-100">
          {
            experiences.map((exp) => (
              <div class="group py-6 flex flex-col md:flex-row md:items-start gap-4 hover:bg-[var(--color-tertiary)] -mx-4 px-4 rounded-2xl transition-colors duration-200 cursor-pointer">
                <!-- Date -->
                <div class="md:w-48 flex-shrink-0">
                  <p class="text-xs text-[var(--color-secondary)] font-medium">
                    {exp.date}
                  </p>
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <h3 class="text-base font-semibold text-[var(--color-primary)] mb-0.5">
                    {exp.company}
                  </h3>
                  <p class="text-xs text-[var(--color-secondary)] font-medium mb-2 italic">
                    {exp.role}
                  </p>
                  {exp.featured && (
                    <div class="flex gap-3 mb-3">
                      <img
                        src="/project-1.png"
                        alt={exp.company}
                        class="w-16 h-12 object-cover rounded-lg flex-shrink-0"
                      />
                      <img
                        src="/project-2.png"
                        alt={exp.company}
                        class="w-16 h-12 object-cover rounded-lg flex-shrink-0"
                      />
                    </div>
                  )}
                  <p class="text-sm text-[var(--color-secondary)] leading-relaxed">
                    {exp.description}
                  </p>
                </div>

                <!-- Tags + arrow -->
                <div class="flex items-center gap-2 md:flex-col md:items-end flex-shrink-0">
                  <div class="flex flex-wrap gap-1.5 justify-end">
                    {exp.tags.map((tag) => (
                      <span class="text-xs font-medium px-3 py-1 rounded-full border border-[var(--color-secondary)] text-[var(--color-secondary)] group-hover:border-[var(--color-primary)] group-hover:text-[var(--color-primary)] transition-colors duration-200">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <div class="w-8 h-8 rounded-full border border-gray-200 group-hover:bg-[var(--color-primary)] group-hover:border-[var(--color-primary)] group-hover:text-white text-[var(--color-secondary)] flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 mt-1">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M7 17L17 7M17 7H7M17 7v10" />
                    </svg>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
